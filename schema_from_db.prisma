generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id          Int      @id @default(autoincrement())
  content     String
  date        DateTime @unique
  lastUpdated DateTime @default(now())
  preferences Json?
}

model TimerSession {
  id                   Int       @id @default(autoincrement())
  type                 String
  content              String?
  startTime            DateTime  @default(now())
  endTime              DateTime?
  duration             Int
  endType              String?
  sessionId            String
  lastHeartbeat        DateTime  @default(now())
  accumulatedElapsedMs Int       @default(0)
  pauseNote            String?
  pausedAt             DateTime?
  status               String    @default("RUNNING")
}

model ChatHistory {
  id        Int      @id @default(autoincrement())
  type      String
  timestamp DateTime @default(now())
  title     String
  input     Json
  output    Json
  metadata  Json?
}

model OKR {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  targetDate    DateTime?
  status        String       @default("ACTIVE")
  successMetric String?
  color         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  initiatives   Initiative[]
}

model Initiative {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  okrId       Int
  status      String    @default("ACTIVE")
  targetDate  DateTime?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  okr         OKR       @relation(fields: [okrId], references: [id])
  projects    Project[]
}

model Project {
  id                 Int               @id @default(autoincrement())
  title              String
  description        String?
  initiativeId       Int?
  status             String            @default("ACTIVE")
  targetDate         DateTime?
  color              String?
  stakeholderGroupId Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  initiative         Initiative?       @relation(fields: [initiativeId], references: [id])
  stakeholderGroup   StakeholderGroup? @relation(fields: [stakeholderGroupId], references: [id])
  tasks              Task[]
}

model Task {
  id                 Int               @id @default(autoincrement())
  title              String
  description        String?
  status             String            @default("TODO")
  priority           String            @default("P2")
  moscowClass        String?           @default("SHOULD")
  effort             String?           @default("M")
  estimatedPomodoros Int               @default(1)
  actualPomodoros    Int               @default(0)
  dueDate            DateTime?
  scheduledDate      DateTime?
  completedAt        DateTime?
  tags               String[]
  projectId          Int?
  stakeholderGroupId Int?
  taskType           String            @default("STRATEGIC")
  aiGenerated        Boolean           @default(false)
  aiReasoning        String?
  sortOrder          Int               @default(0)
  parentTaskId       Int?
  captureResolvedId  Int?              @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  resolvedFrom       CaptureItem?      @relation(fields: [captureResolvedId], references: [id])
  parentTask         Task?             @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks           Task[]            @relation("SubTasks")
  project            Project?          @relation(fields: [projectId], references: [id])
  stakeholderGroup   StakeholderGroup? @relation(fields: [stakeholderGroupId], references: [id])
}

model StakeholderGroup {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  color        String?
  type         String    @default("ENGINEERING")
  slackChannel String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  tasks        Task[]
}

model DayPlan {
  id                    Int      @id @default(autoincrement())
  date                  DateTime @unique
  meetingHours          Float    @default(0)
  energyLevel           String   @default("MEDIUM")
  availableFocusMinutes Int      @default(0)
  scheduledTaskIds      Json?
  captureInboxIds       Json?
  aiScheduleSummary     String?
  aiFocusAdvice         String?
  interruptLog          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CaptureItem {
  id             Int      @id @default(autoincrement())
  rawText        String
  processed      Boolean  @default(false)
  resolvedTaskId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  resolvedTask   Task?
}



generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id          Int      @id @default(autoincrement())
  content     String
  date        DateTime @unique
  lastUpdated DateTime @default(now())
  preferences Json?
}

model TimerSession {
  id                   Int       @id @default(autoincrement())
  type                 String
  content              String?
  startTime            DateTime  @default(now())
  endTime              DateTime?
  duration             Int
  endType              String?
  sessionId            String
  lastHeartbeat        DateTime  @default(now())
  status               String    @default("RUNNING")
  pauseNote            String?
  accumulatedElapsedMs Int       @default(0)
  pausedAt             DateTime?
  hardStopTriggered    Boolean   @default(false)
  extensionCount       Int       @default(0)
}

model ChatHistory {
  id        Int      @id @default(autoincrement())
  type      String
  timestamp DateTime @default(now())
  title     String
  input     Json
  output    Json
  metadata  Json?
}

model Objective {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  quarter       String?
  type          String       @default("MOONSHOT") // MOONSHOT, ROOFSHOT
  status        String       @default("ACTIVE") // ACTIVE, ACHIEVED, PAUSED, CLOSED
  color         String?
  healthMetrics Json?
  keyResults    KeyResult[]
  initiatives   Initiative[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model KeyResult {
  id            Int                   @id @default(autoincrement())
  objectiveId   Int
  objective     Objective             @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  metric        String
  description   String?
  unit          String                @default("count") // count, %, $, hours, score
  direction     String                @default("INCREASE") // INCREASE, DECREASE, ACHIEVE
  baselineValue Float                 @default(0)
  currentValue  Float                 @default(0)
  targetValue   Float                 @default(100)
  confidence    Float                 @default(0.5)
  grade         Float?
  targetDate    DateTime?
  initiatives   InitiativeKeyResult[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Initiative {
  id             Int                   @id @default(autoincrement())
  title          String
  description    String?
  hypothesis     String? // The strategic bet: "We believe that..."
  objectiveId    Int
  objective      Objective             @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResults     InitiativeKeyResult[]
  status         String                @default("ACTIVE") // ACTIVE, ON_HOLD, ARCHIVED
  priority       String                @default("P1") // P0, P1, P2
  dri            String? // Directly Responsible Individual
  targetDate     DateTime?
  ambiguityLevel String                @default("MEDIUM")
  keyUnknowns    String[]
  projects       Project[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model InitiativeKeyResult {
  initiativeId Int
  keyResultId  Int
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  keyResult    KeyResult  @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@id([initiativeId, keyResultId])
}

model Project {
  id                 Int               @id @default(autoincrement())
  title              String
  description        String?
  successCriteria    String? // Definition of Done for this project
  initiativeId       Int?
  initiative         Initiative?       @relation(fields: [initiativeId], references: [id])
  status             String            @default("PLANNING") // PLANNING, ACTIVE, ON_HOLD, DONE
  priority           String            @default("P1") // P0, P1, P2
  dri                String? // Directly Responsible Individual
  targetDate         DateTime?
  color              String?
  stakeholderGroupId Int?
  stakeholderGroup   StakeholderGroup? @relation(fields: [stakeholderGroupId], references: [id])
  expectedImpact     String?
  actualImpact       String?
  isL6PromoMaterial  Boolean           @default(false)
  tasks              Task[]
  aiGenerated        Boolean           @default(false)
  aiReasoning        String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Sprint {
  id              Int       @id @default(autoincrement())
  name            String    // e.g., "Week of May 4th"
  startDate       DateTime  // Monday
  endDate         DateTime  // Friday
  status          String    @default("DRAFT") // DRAFT, PROPOSED, ACTIVE, CLOSED
  aiSummary       String?   
  capacityMinutes Int       @default(2400) // 40 hours
  tasks           Task[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Task {
  id                 Int               @id @default(autoincrement())
  title              String
  context            String?           // Was description, but renamed/adapted for single-line context
  status             String            @default("BACKLOG") // BACKLOG, TODO, IN_PROGRESS, DONE, BLOCKED, DEFERRED
  
  // Single-line visible fields:
  size               String            @default("M") // XS, S, M, L, XL
  impact             String            @default("BUCKET") // NEEDLE or BUCKET
  
  // Tracking
  actualMinutes      Int               @default(0)
  isUnplanned        Boolean           @default(false)
  
  // Relations
  sprintId           Int?
  sprint             Sprint?           @relation(fields: [sprintId], references: [id])
  projectId          Int?
  project            Project?          @relation(fields: [projectId], references: [id])
  stakeholderGroupId Int?
  stakeholderGroup   StakeholderGroup? @relation(fields: [stakeholderGroupId], references: [id])
  
  // Subtasks/Capture links (kept for functionality)
  parentTaskId       Int?
  parentTask         Task?             @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks           Task[]            @relation("SubTasks")
  captureResolvedId  Int?              @unique
  resolvedFrom       CaptureItem?      @relation(fields: [captureResolvedId], references: [id])
  
  aiGenerated        Boolean           @default(false)
  aiReasoning        String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model StakeholderGroup {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  color        String?
  type         String    @default("ENGINEERING") // ENGINEERING, DATA, DESIGN, LEADERSHIP, EXTERNAL, PARTNER
  slackChannel String?
  projects     Project[]
  tasks        Task[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DayPlan {
  id                    Int      @id @default(autoincrement())
  date                  DateTime @unique
  meetingHours          Float    @default(0)
  energyLevel           String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  availableFocusMinutes Int      @default(0)
  scheduledTaskIds      Json? // Array of task IDs
  captureInboxIds       Json? // Array of CaptureItem IDs
  aiScheduleSummary     String?
  aiFocusAdvice         String?
  interruptLog          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CaptureItem {
  id             Int      @id @default(autoincrement())
  rawText        String
  processed      Boolean  @default(false)
  resolvedTaskId Int?
  resolvedTask   Task?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
